# Developer runtime configuration
# Copy this file to .dev.env and customize if needed.

# Backend server port
BACKEND_PORT=8081

# Frontend static server port
FRONTEND_PORT=5500

# Startup readiness timeouts (seconds)
BACKEND_READY_TIMEOUT=180
FRONTEND_READY_TIMEOUT=20

# Database connection for backend
DB_URL=jdbc:mysql://localhost:3306/career_planning_system?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=sabhari
DB_PASSWORD=ss

# Google Sign-In OAuth client ID (Web application type)
GOOGLE_AUTH_CLIENT_ID=
